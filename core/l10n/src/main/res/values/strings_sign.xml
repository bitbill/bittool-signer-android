<?xml version="1.0" encoding="utf-8"?>
<!--
  Strings of :feature:sign (owner: W2-sign). English only until the translation pass (DECISIONS §9.2).
  The first group is iOS English that is not in the iOS catalogue (gaps.md G6; ARCHITECTURE §4.3 table): iOS draws it
  untranslated, the Android port translates it. The resolver's matching messages, "Reading request…" and "Keep the
  animated code in view · %d parts" joined the iOS catalogue (iOS ff2756f) and are its resources now: never add them
  here again.
-->
<resources>
    <!-- MatchingIssue.Interrupted (AppStore.swift:92): the session was suspended while the request was being matched. -->
    <string name="sign_matching_interrupted">Matching interrupted. Try again.</string>
    <!-- MatchingIssue.Unsupported (AppStore.swift:373): the engine review did not set canSign. -->
    <string name="sign_unsupported_signing_protocol">Unsupported signing protocol</string>
    <!-- Signature result payload note for a PSBT response (SignatureResultView.swift:81). psbt_base64 and decoded are JSON keys. -->
    <string name="sign_psbt_payload_note">psbt_base64 is the exact PSBT this QR code carries; decoded is read from it for reference.</string>

    <!-- Android-only. Review at large text sizes: the risk acknowledgement (a checkbox row, "I understand the risks of
         this request") then scrolls as the last item of the review instead of sitting above Sign; this line in the
         bar above the disabled Sign button says where it is, and tapping it scrolls there. -->
    <string name="sign_acknowledgement_hint">Check the box at the end of the review to sign.</string>
    <!-- Android-only. Import File: the system could not open or read the chosen document (iOS shows the OS error text;
         ARCHITECTURE §4.2 keeps platform exception messages out of the UI). -->
    <string name="sign_file_unreadable">The file could not be read.</string>
    <!-- Android-only. Export as File: shown when the system reports no message of its own for a failed save. -->
    <string name="sign_file_not_saved">The file could not be saved.</string>
</resources>
