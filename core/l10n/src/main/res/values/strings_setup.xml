<?xml version="1.0" encoding="utf-8"?>
<!-- Android strings of :feature:setup (owner: W2-setup). English only until the translation pass (DECISIONS §9.2).
     The first five are iOS strings that are not in the 773-key catalogue (gaps.md G6, setup-backup.md §14.3): the exact
     iOS English. The two screenshot messages are the Android wording of DECISIONS §9.4. -->
<resources>
    <!-- RecoveryCopy.screenshotTitle (Features/Setup/RecoveryPhraseViews.swift:348), title of both screenshot alerts. -->
    <string name="setup_screenshot_detected">Screenshot Detected</string>
    <!-- Recovery QR scanner error (Features/Setup/WalletSetupFlow.swift:226). -->
    <string name="setup_qr_not_recovery_phrase">This QR code does not contain a recovery phrase.</string>
    <!-- Recovery cards warning for 12/15-word phrases (Features/Backup/RecoveryBackupViews.swift:212-215). Arguments:
         1 word count, 2 words shown on each card (count minus a third), 3 word count again, 4 words left out. -->
    <string name="setup_weak_cards_warning">With a %1$d-word phrase each card shows %2$d of the %3$d words, and the other %4$d could be worked out with enough computing power. Guard every card as carefully as the full phrase, or use a 24-word phrase for split backups.</string>
    <!-- Accessibility values of an empty blank of the backup check (Features/Backup/RecoveryBackupViews.swift:483). -->
    <string name="setup_slot_empty">Empty</string>
    <string name="setup_slot_empty_next">Empty, next to fill</string>
    <!-- Android wording of the two iOS screenshot messages ("Photos, Recently Deleted" are iOS app names). -->
    <string name="setup_screenshot_phrase_hidden">The phrase is hidden again, but the screenshot may already contain it. Delete it from your gallery and any synced copies, and keep a written backup offline.</string>
    <string name="setup_screenshot_may_contain">The screenshot may contain your recovery phrase or some of its words. Delete it from your gallery and any synced copies, and keep a written backup offline.</string>
    <!-- Android only (QA wallets-04): title of the screen-lock requirement, shown with crypto_device_lock_required on
         the first setup step and in Welcome's dialog (strings_onboarding has no copy of it) before anything is typed. -->
    <string name="setup_screen_lock_required">Screen Lock Required</string>
    <!-- Android only (QA backlog B21, L4): the password step when the phrase belongs to a wallet here whose device key is
         provably gone (title: wallets_lost_key_title). "Remove This Wallet" names the control of the wallet page
         (wallets_lost_key_remove): use the same words. -->
    <string name="setup_lost_key_message">This recovery phrase belongs to a wallet on this device whose device key is gone, so its password cannot be reset. Open that wallet, choose Remove This Wallet, and import the phrase again.</string>
    <string name="setup_lost_key_open_wallet">Open Wallet</string>
    <!-- Android only (QA L3): the password step when the phrase belongs to a wallet here whose public data can no longer
         be verified (its key is fine), so it needs the wallet page's Repair (with its password) instead of a second
         import. Title of the step. -->
    <string name="setup_repair_duplicate_title">This Wallet Needs Repair</string>
    <!-- Text of that step; "Repair Wallet Data" names the control of the wallet page (iOS repair_wallet_data). -->
    <string name="setup_repair_duplicate_message">This recovery phrase belongs to a wallet on this device whose public data needs repair. Open that wallet and choose Repair Wallet Data with its password. Importing the phrase again would only add a second wallet with the same keys.</string>
</resources>
