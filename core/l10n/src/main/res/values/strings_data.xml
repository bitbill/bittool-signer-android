    <string name="data_engine_entropy_unavailable">The engine’s secure entropy source could not be installed.</string>
    <!-- ENGINE_FAILURE, SigningEngine.swift:82 -->
    <string name="data_engine_failure">The offline engine could not process this request.</string>
    <!-- UNSUPPORTED_OPERATION, SigningEngine.swift:152 -->
    <string name="data_engine_unsupported_operation">This signing operation is not supported.</string>
    <!-- REQUEST_TOO_LARGE, SigningEngine.swift:192 -->
