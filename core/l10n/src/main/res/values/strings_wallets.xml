<?xml version="1.0" encoding="utf-8"?>
<!--
    Android-only strings of :feature:wallets (owner: W2-wallets). English only until the translation pass
    (DECISIONS §4, §9.2). Every other text of the Wallets tab, wallet page, Addresses, Pair and the wallet security pages
    is an iOS catalogue string (strings_ios.xml) or a :core:ui / :core:security resource; the toast after a password
    change reuses the catalogue key "Password Changed" (ARCHITECTURE §4.3 table).
-->
<resources>
    <!-- The QR brightness switch on the Pair and address QR codes (wallets-pairing.md §13.5; iOS never changes the
         brightness, so it has no text for it). Read by TalkBack as "<name>, <state>". -->
    <string name="wallets_qr_brightness">Screen brightness</string>
    <!-- Switch state: the system brightness is left alone. -->
    <string name="wallets_qr_brightness_normal">Normal</string>
    <!-- Switch state: full brightness while the code is shown, for cameras that struggle with a dim screen. -->
    <string name="wallets_qr_brightness_bright">Bright</string>

    <!--
      Android-only (no iOS text): removing a wallet whose device key is provably gone (QA backlog B9,
      SignerStore.removeWalletWithLostDeviceKey): the Delete Wallet page shows them instead of the iOS password path.
      The vault's refusal of such a removal is crypto_device_key_loss_unconfirmed (strings_crypto.xml).
    -->
    <!-- Callout title on the Delete Wallet page. -->
    <string name="wallets_lost_key_title">This Wallet Can’t Be Unlocked</string>
    <!-- Android only: card status and wallet-page callout title while Keystore keeps the keys locked (shown with
         crypto_device_locked): the phone must be unlocked once with its screen lock. -->
    <string name="wallets_keys_locked_title">Unlock with Your Screen Lock</string>
    <!-- Callout text: why the password cannot help and how the wallet is restored. -->
    <string name="wallets_lost_key_message">Its device key is no longer on this device, so the wallet cannot be unlocked, even with the right password. Remove it here, then import its recovery phrase and any BIP39 passphrase again to restore it. Funds are not affected.</string>
    <!-- The confirmation switch the person must turn on first. -->
    <string name="wallets_lost_key_confirm">I understand that only the recovery phrase can restore this wallet</string>
    <!-- Footer under the switch (App Lock off). -->
    <string name="wallets_lost_key_footer">Removing this wallet does not ask for its password: the device key the password needs is gone.</string>
    <!-- Footer under the switch (App Lock on with biometrics). -->
    <string name="wallets_lost_key_footer_biometric">Removing this wallet asks for biometric confirmation, not for its password: the device key the password needs is gone.</string>
    <!-- The page's destructive button. -->
    <string name="wallets_lost_key_remove">Remove This Wallet</string>
    <!-- The final confirmation dialog. -->
    <string name="wallets_lost_key_dialog_title">Remove This Wallet?</string>
    <string name="wallets_lost_key_dialog_message">Its encrypted file is deleted from this device without the password. Only its recovery phrase and any BIP39 passphrase can restore it.</string>
    <string name="wallets_lost_key_dialog_confirm">Remove</string>
</resources>
