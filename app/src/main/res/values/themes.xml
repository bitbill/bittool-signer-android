<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BitToolSigner" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.BitToolSigner.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/launch_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.BitToolSigner</item>
    </style>
</resources>
